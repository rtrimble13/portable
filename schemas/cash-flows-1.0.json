{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rtrimble13/portable/schemas/cash-flows-1.0.json",
  "title": "pt cash-flows",
  "description": "The cash-flow series pert consumes.\n\n`level` is required in the output, not merely accepted as input, because the same transaction has different answers at account and portfolio level and a consumer that does not know which it received cannot use it (PORT-GIPS-B02).",
  "allOf": [{ "$ref": "envelope-1.0.json" }],
  "type": "object",
  "properties": {
    "command": { "const": "cash-flows" },
    "data": {
      "type": "object",
      "required": ["level", "external_only", "net_external_flow", "rows"],
      "properties": {
        "level": { "enum": ["account", "portfolio"] },
        "external_only": { "type": "boolean" },
        "net_external_flow": { "$ref": "envelope-1.0.json#/$defs/decimal" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "classification", "amount"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "classification": {
                "enum": ["external", "internal", "income", "cost"]
              },
              "amount": { "$ref": "envelope-1.0.json#/$defs/decimal" }
            }
          }
        }
      }
    }
  }
}
