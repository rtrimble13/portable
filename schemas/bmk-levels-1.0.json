{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rtrimble13/portable/schemas/bmk-levels-1.0.json",
  "title": "bmk levels",
  "description": "An index's levels, one row per trading day it was built for (ADR 0050). Refused unless the build is current: built from the definition and inputs the file holds now, whose hash is `inputs_hash`.\n\nTwo levels, labelled by `return_types`: `total_return_level` reinvests each dividend across the index at its ex-date close, gross of withholding; `price_level` is price-only and is never a benchmark (PORT-GIPS-G01). `is_theoretical` is fixed true: a synthetic index is never linked onto a portfolio's own returns (PORT-GIPS-J04). Every decimal is a string at full precision.",
  "allOf": [{ "$ref": "envelope-1.0.json" }],
  "type": "object",
  "properties": {
    "command": { "const": "levels" },
    "disclaimer": { "type": "null" },
    "data": {
      "type": "object",
      "required": [
        "rows", "columns", "index_name", "description", "base_date", "base_level",
        "currency", "calendar", "inputs_hash", "is_theoretical", "is_net_of_withholding",
        "return_types"
      ],
      "properties": {
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "index_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "base_date": { "$ref": "#/$defs/date" },
        "base_level": { "$ref": "#/$defs/decimal" },
        "currency": { "const": "USD" },
        "calendar": { "type": "string", "minLength": 1 },
        "inputs_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "is_theoretical": { "const": true },
        "is_net_of_withholding": { "const": false },
        "return_types": {
          "type": "object",
          "required": ["total_return_level", "price_level"],
          "additionalProperties": false,
          "properties": {
            "total_return_level": { "const": "total_return" },
            "price_level": { "const": "price_only" }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "decimal": { "$ref": "envelope-1.0.json#/$defs/decimal" },
    "row": {
      "type": "object",
      "required": [
        "date", "total_return_level", "price_level", "dividend_points", "rebalance",
        "reconstitution", "members"
      ],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "total_return_level": { "$ref": "#/$defs/decimal" },
        "price_level": { "$ref": "#/$defs/decimal" },
        "dividend_points": {
          "description": "Index points of the dividends going ex that day: zero, not null, on a day with none.",
          "$ref": "#/$defs/decimal"
        },
        "rebalance": { "type": "boolean" },
        "reconstitution": { "type": "boolean" },
        "members": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
